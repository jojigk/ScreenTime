<Window x:Class="ScreenTimeAgent.Overlay.CountdownOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTime"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Background="#E6202020">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Screen time is almost up"
                       FontSize="14" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock x:Name="CountdownText" Text="300"
                       FontSize="28" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="SubtitleText" Text="seconds remaining"
                       FontSize="12" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
